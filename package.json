{
  "name": "cubicost-learning-centre",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "firebase:rules": "node scripts/generateFirebaseRules.mjs",
    "test:unit": "node --test tests/firebase/submissions.test.mjs tests/firebase/assessmentReview.test.mjs",
    "test:rules": "node --test tests/firebase/rules.test.mjs",
    "test:firebase": "firebase emulators:exec --project demo-cubicost --only auth,firestore \"npm run test:rules && playwright test\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "firebase-tools": "^15.33.0",
    "globals": "17.12.0",
    "vite": "8.2.2"
  }
}
